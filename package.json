{
  "name": "sunrise-moonrise",
  "version": "1.0.0",
  "private": true,
  "description": "An opportunities tracker for people juggling more than one kind of application at once.",
  "scripts": {
    "build": "esbuild src/entry.jsx --bundle --minify --loader:.js=jsx --format=iife --outfile=bundle.js",
    "watch": "esbuild src/entry.jsx --bundle --loader:.js=jsx --format=iife --outfile=bundle.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
